{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "User": {
      "type": "String",
      "defaultValue": "DefaultUser"
    },
    "Env": {
      "type": "String",
      "defaultValue": "development"
    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {}
      }
    }
  },
  "actions": {
    "Response": {
      "type": "Response",
      "inputs": {
        "statusCode": 200,
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "Hello, @{parameters('User')}!\nEnv: @{parameters('Env')}\nTimestamp: @{utcNow('yyyy-MM-dd HH:mm:ss UTC')}"
      },
      "runAfter": {}
    }
  },
  "outputs": {}
}